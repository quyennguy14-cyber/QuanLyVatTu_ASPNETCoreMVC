@model IEnumerable<Receipt>
@{ViewData["Title"]="Phiếu nhập kho";}
<div class="d-flex justify-content-between mb-3"><h2>Phiếu nhập kho</h2><a asp-action="Create" class="btn btn-primary">+ Lập phiếu nhập</a></div>
<div class="card p-3"><table class="table"><thead><tr><th>Mã phiếu</th><th>Ngày nhập</th><th>Ghi chú</th><th>Số dòng vật tư</th></tr></thead><tbody>
@foreach(var x in Model){<tr><td>@x.Code</td><td>@x.Date.ToString("dd/MM/yyyy")</td><td>@x.Note</td><td>@x.Details.Count</td></tr>}
</tbody></table></div>

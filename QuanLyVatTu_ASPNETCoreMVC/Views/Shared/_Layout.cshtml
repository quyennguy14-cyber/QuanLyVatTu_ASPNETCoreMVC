<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Quản lý vật tư</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
  <div class="container">
    <a class="navbar-brand" asp-controller="Home" asp-action="Index">QUẢN LÝ VẬT TƯ</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" asp-controller="Materials" asp-action="Index">Vật tư</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Categories" asp-action="Index">Danh mục</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Suppliers" asp-action="Index">Nhà cung cấp</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Receipts" asp-action="Index">Phiếu nhập</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Issues" asp-action="Index">Phiếu xuất</a></li>
      </ul>
      <div class="d-flex gap-2">
        @if (Context.Session.GetString("Username") == null) {
          <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Đăng nhập</a>
        } else {
          <span class="navbar-text text-white">@Context.Session.GetString("FullName")</span>
          <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
        }
      </div>
    </div>
  </div>
</nav>
<main class="container py-4">
  @if (TempData["Message"] != null) { <div class="alert alert-info alert-dismissible fade show">@TempData["Message"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
  @RenderBody()
</main>
<footer class="text-center text-muted border-top py-3">Đề tài bài tập lớn ASP.NET Core MVC - Quản lý vật tư</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

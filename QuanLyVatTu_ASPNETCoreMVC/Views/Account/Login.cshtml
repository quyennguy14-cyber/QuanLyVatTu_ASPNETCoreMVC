@model LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="card form-card p-4">
<h2>Đăng nhập hệ thống</h2>
<p class="text-muted">Tài khoản demo: admin / Admin@123</p>
<form asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Username" class="form-label"></label><input asp-for="Username" class="form-control" /><span asp-validation-for="Username" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger"></span></div>
    <div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label"></label></div>
    <button class="btn btn-primary">Đăng nhập</button>
</form>
</div>
